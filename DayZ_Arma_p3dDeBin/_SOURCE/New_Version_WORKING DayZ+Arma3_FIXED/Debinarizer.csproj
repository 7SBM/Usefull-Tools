<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>Debinarizer</AssemblyName>
    <RootNamespace>P3DDebinarizer</RootNamespace>
    <ApplicationIcon>7SBM_P3d.DeBin.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="7SBM_P3d.DeBin.ico" />
    <EmbeddedResource Include="7SBM_P3d.DeBin.ico" />
    <EmbeddedResource Include="theme_loop.wav" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BisDll">
      <HintPath>BisDll.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>

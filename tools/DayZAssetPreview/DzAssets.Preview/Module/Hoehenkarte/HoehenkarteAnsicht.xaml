<UserControl x:Class="DzAssets.Preview.Module.Hoehenkarte.HoehenkarteAnsicht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DzAssets.Preview.Module.Hoehenkarte"
             Background="{DynamicResource PinselGrund}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="240" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="310" MinWidth="250" />
    </Grid.ColumnDefinitions>

    <!-- ============ Links: Karten ============ -->
    <Border Grid.Column="0" Background="{DynamicResource PinselFlaeche}"
            BorderBrush="{DynamicResource PinselRand}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="14,14,14,10">
          <Button x:Name="KnopfDatei" Content="Karte öffnen…" Click="Datei_Click"
                  HorizontalAlignment="Stretch" />
          <Button x:Name="KnopfOrdner" Content="Ordner durchsuchen…" Click="Ordner_Click"
                  HorizontalAlignment="Stretch" Margin="0,7,0,0" />
        </StackPanel>

        <ListBox x:Name="KartenListe" Grid.Row="1"
                 Background="Transparent" BorderThickness="0"
                 SelectionChanged="KartenListe_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Beschreibung}" Style="{StaticResource StilNebentext}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Padding="14,10" BorderBrush="{DynamicResource PinselRand}"
                BorderThickness="0,1,0,0">
          <TextBlock x:Name="ListeText" Style="{StaticResource StilNebentext}"
                     TextTrimming="CharacterEllipsis"
                     Text="Noch keine Karte geladen" />
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

    <!-- ============ Mitte: 3D ============ -->
    <Grid Grid.Column="2">
      <local:GelaendeViewport x:Name="Viewport" />

      <Border x:Name="HinweisRahmen"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource PinselFlaeche}" Opacity="0.95"
              BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
              CornerRadius="{DynamicResource RadiusGross}" Padding="24,18">
        <StackPanel>
          <TextBlock x:Name="Hinweis"
                     Text="Eine ASC-Höhenkarte öffnen"
                     Style="{StaticResource StilNebentext}"
                     TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
          <ProgressBar x:Name="Fortschritt" Height="4" Margin="0,12,0,0"
                       Visibility="Collapsed" Minimum="0" Maximum="100"
                       Background="{DynamicResource PinselFlaecheHoch}"
                       Foreground="{DynamicResource PinselAkzent}"
                       BorderThickness="0" />
        </StackPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

    <!-- ============ Rechts: Angaben und Einstellungen ============ -->
    <Border Grid.Column="4" Background="{DynamicResource PinselFlaeche}"
            BorderBrush="{DynamicResource PinselRand}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
          <TextBlock x:Name="InfoName" Style="{StaticResource StilUeberschrift}"
                     TextWrapping="Wrap" Text="—" />
          <TextBlock x:Name="InfoPfad" Style="{StaticResource StilNebentext}"
                     TextWrapping="Wrap" Margin="0,5,0,0" />

          <Border Height="1" Background="{DynamicResource PinselRand}" Margin="0,16" />

          <TextBlock Text="RASTER" Style="{StaticResource StilFeldname}" />
          <TextBlock x:Name="InfoRaster" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="AUSDEHNUNG" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoAusdehnung" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="HÖHE" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoHoehe" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="LÜCKEN (NODATA)" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoLuecken" Style="{StaticResource StilWert}" Text="—" />

          <Border Height="1" Background="{DynamicResource PinselRand}" Margin="0,16" />

          <TextBlock Text="FARBSKALA" Style="{StaticResource StilFeldname}" />
          <ComboBox x:Name="SkalaAuswahl" Margin="0,5,0,0"
                    SelectionChanged="Darstellung_Geaendert" />

          <TextBlock Text="NETZFEINHEIT" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <ComboBox x:Name="NetzAuswahl" Margin="0,5,0,0"
                    SelectionChanged="Darstellung_Geaendert" />
          <TextBlock x:Name="NetzHinweis" Style="{StaticResource StilNebentext}"
                     Margin="0,4,0,0" TextWrapping="Wrap" />

          <Grid Margin="0,14,0,0">
            <TextBlock Text="ÜBERHÖHUNG" Style="{StaticResource StilFeldname}" />
            <TextBlock x:Name="UeberhoehungText" Style="{StaticResource StilNebentext}"
                       HorizontalAlignment="Right" Text="1,0 ×" />
          </Grid>
          <Slider x:Name="UeberhoehungRegler" Minimum="0.2" Maximum="6" Value="1"
                  TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,5,0,0"
                  ValueChanged="Ueberhoehung_Geaendert" />

          <Grid Margin="0,10,0,0">
            <TextBlock Text="SCHUMMERUNG" Style="{StaticResource StilFeldname}" />
            <TextBlock x:Name="SchummerungText" Style="{StaticResource StilNebentext}"
                       HorizontalAlignment="Right" Text="65 %" />
          </Grid>
          <Slider x:Name="SchummerungRegler" Minimum="0" Maximum="1" Value="0.65"
                  TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,5,0,0"
                  ValueChanged="Darstellung_Geaendert" />

          <CheckBox x:Name="SchalterDraht" Content="Netz zeigen" Margin="0,14,0,0"
                    Checked="Draht_Geaendert" Unchecked="Draht_Geaendert" />

          <Button x:Name="KnopfEinrahmen" Content="Einrahmen" Margin="0,16,0,0"
                  HorizontalAlignment="Stretch" Click="Einrahmen_Click" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

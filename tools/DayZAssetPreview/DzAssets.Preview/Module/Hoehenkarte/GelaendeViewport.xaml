<UserControl x:Class="DzAssets.Preview.Module.Hoehenkarte.GelaendeViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PinselGrund}"
             Focusable="True"
             ClipToBounds="True">
  <Grid>
    <Viewport3D x:Name="Sicht">
      <Viewport3D.Camera>
        <PerspectiveCamera x:Name="Kamera" FieldOfView="45"
                           Position="0,1000,2000" LookDirection="0,-1000,-2000"
                           UpDirection="0,1,0" />
      </Viewport3D.Camera>

      <ModelVisual3D>
        <ModelVisual3D.Content>
          <Model3DGroup x:Name="Szene">
            <AmbientLight Color="#6A7080" />
            <DirectionalLight Color="#FFF6EC" Direction="-0.6,-0.7,-0.4" />
            <DirectionalLight Color="#40506A" Direction="0.6,0.3,0.5" />
          </Model3DGroup>
        </ModelVisual3D.Content>
      </ModelVisual3D>
    </Viewport3D>

    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14"
            Background="{DynamicResource PinselFlaeche}" Opacity="0.9"
            BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusKlein}" Padding="11,7">
      <TextBlock Style="{StaticResource StilNebentext}"
                 Text="Links drehen · Rechts verschieben · Rad zoomen · F einrahmen" />
    </Border>
  </Grid>
</UserControl>

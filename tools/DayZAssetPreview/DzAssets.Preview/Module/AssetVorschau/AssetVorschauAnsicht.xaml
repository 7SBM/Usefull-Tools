<UserControl x:Class="DzAssets.Preview.Module.AssetVorschau.AssetVorschauAnsicht"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DzAssets.Preview.Module.AssetVorschau"
             Background="{DynamicResource PinselGrund}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="240" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="5" />
      <ColumnDefinition Width="300" MinWidth="240" />
    </Grid.ColumnDefinitions>

    <!-- ============ Links: Suche und Baum ============ -->
    <Border Grid.Column="0" Background="{DynamicResource PinselFlaeche}"
            BorderBrush="{DynamicResource PinselRand}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="14,14,14,10">
          <TextBox x:Name="SuchFeld" TextChanged="SuchFeld_TextChanged" Padding="31,7,9,7" />
          <TextBlock Text="&#xE721;" FontFamily="{DynamicResource SchriftSymbole}"
                     FontSize="13" Foreground="{DynamicResource PinselTextSchwach}"
                     Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock x:Name="SuchHinweis" Text="Modelle durchsuchen…"
                     Style="{StaticResource StilNebentext}"
                     Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Row="1">
          <TreeView x:Name="Baum"
                    Background="Transparent" BorderThickness="0"
                    SelectedItemChanged="Baum_SelectedItemChanged"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Kinder}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock Text="{Binding Symbol}"
                             FontFamily="{DynamicResource SchriftSymbole}" FontSize="12"
                             Foreground="{DynamicResource PinselTextSchwach}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding Beschriftung}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <ListBox x:Name="Trefferliste" Visibility="Collapsed"
                   Background="Transparent" BorderThickness="0"
                   SelectionChanged="Trefferliste_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Width="46" Height="46" CornerRadius="{DynamicResource RadiusKlein}"
                          Background="{DynamicResource PinselGrund}"
                          BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
                          Margin="0,0,10,0">
                    <Image Source="{Binding Vorschau}" Stretch="Uniform" Margin="1" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" MaxWidth="196">
                    <TextBlock Text="{Binding Eintrag.Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Eintrag.Ordner}" Style="{StaticResource StilNebentext}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" BorderBrush="{DynamicResource PinselRand}"
                BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="KnopfNeuEinlesen" Content="Neu einlesen" Click="NeuEinlesen_Click"
                    ToolTip="Bestand erneut von der Platte lesen" />
            <TextBlock x:Name="BestandText" Style="{StaticResource StilNebentext}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

    <!-- ============ Mitte: Viewport ============ -->
    <Grid Grid.Column="2">
      <local:ModelViewport x:Name="Viewport" />
      <Border x:Name="HinweisRahmen"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource PinselFlaeche}" Opacity="0.95"
              BorderBrush="{DynamicResource PinselRand}" BorderThickness="1"
              CornerRadius="{DynamicResource RadiusGross}" Padding="22,16">
        <TextBlock x:Name="ViewportHinweis"
                   Text="Ein Modell im Baum auswählen"
                   Style="{StaticResource StilNebentext}"
                   TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
      </Border>
    </Grid>

    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

    <!-- ============ Rechts: Info ============ -->
    <Border Grid.Column="4" Background="{DynamicResource PinselFlaeche}"
            BorderBrush="{DynamicResource PinselRand}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
          <TextBlock x:Name="InfoName" Style="{StaticResource StilUeberschrift}"
                     TextWrapping="Wrap" Text="—" />
          <TextBlock x:Name="InfoPfad" Style="{StaticResource StilNebentext}"
                     TextWrapping="Wrap" Margin="0,5,0,0" />

          <Border Height="1" Background="{DynamicResource PinselRand}" Margin="0,16" />

          <TextBlock Text="MASSE (B × H × T)" Style="{StaticResource StilFeldname}" />
          <TextBlock x:Name="InfoGroesse" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="DREIECKE" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoDreiecke" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="FORMAT" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoVersion" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="KLASSE" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <TextBlock x:Name="InfoKlassen" Style="{StaticResource StilWert}" Text="—" />

          <TextBlock Text="DETAILSTUFE" Style="{StaticResource StilFeldname}" Margin="0,14,0,0" />
          <ComboBox x:Name="LodAuswahl" Margin="0,5,0,0"
                    SelectionChanged="LodAuswahl_SelectionChanged"
                    DisplayMemberPath="Name" />

          <Border Height="1" Background="{DynamicResource PinselRand}" Margin="0,16" />

          <CheckBox x:Name="SchalterGitter" Content="Bodengitter (1 m)" Margin="0,3"
                    Checked="Ansicht_Geaendert" Unchecked="Ansicht_Geaendert" />
          <CheckBox x:Name="SchalterMassstab" Content="Maßstabsfigur 1,80 m" Margin="0,3"
                    Checked="Ansicht_Geaendert" Unchecked="Ansicht_Geaendert" />
          <CheckBox x:Name="SchalterDraht" Content="Drahtgitter" Margin="0,3"
                    Checked="Ansicht_Geaendert" Unchecked="Ansicht_Geaendert" />

          <Button x:Name="KnopfPfadKopieren" Content="Pfad kopieren" Margin="0,16,0,0"
                  HorizontalAlignment="Stretch" Click="PfadKopieren_Click" />

          <Border x:Name="WarnungRahmen" Margin="0,16,0,0" Visibility="Collapsed"
                  Background="{DynamicResource PinselGrund}"
                  BorderBrush="{DynamicResource PinselWarnung}" BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusKlein}" Padding="11,9">
            <TextBlock x:Name="InfoWarnung" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource PinselWarnung}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
